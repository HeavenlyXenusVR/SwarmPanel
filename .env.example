PANEL_DB_HOST=127.0.0.1
PANEL_DB_PORT=3306
PANEL_DB_USER=botuser
PANEL_DB_PASSWORD=CHANGE_ME
PANEL_DB_DEFAULT_SCHEMA=discord_music_gws

PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=CHANGE_ME
PANEL_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Browser origins allowed to call the API cross-origin. Put your own
# public panel host first; add a GitHub Pages origin only if you still
# serve the static Pages frontend against this backend.
PANEL_CORS_ALLOWED_ORIGINS=https://panel.example.com
PANEL_API_TOKEN_TTL_SECONDS=43200
PANEL_EMAIL_VERIFICATION_TTL_SECONDS=86400

# Live/public mode: requires HTTPS-only sessions and explicit public URLs/origins.
PANEL_LIVE_MODE=false
PANEL_SESSION_HTTPS_ONLY=false
SWARM_PANEL_SITE_OWNER_EMAIL=you@example.com
# Leave enabled unless you are intentionally running an isolated local-only panel.
SWARM_PANEL_OWNER_EMAIL_REQUIRES_VERIFICATION=true

# The panel's real public URL. Used for links the backend generates
# (email verification, operator alerts) and handed to the native apps in
# the session payload, so it must be the host users actually reach --
# normally your named Cloudflare tunnel hostname (see
# PANEL_CLOUDFLARE_PUBLIC_URL), not a GitHub Pages address.
PANEL_PAGES_PUBLIC_URL=https://panel.example.com

# Public ingress. "static" = a named Cloudflare tunnel on a hostname you own
# (what this deployment runs), which is why PANEL_PAGES_PUBLIC_URL above can
# be a fixed value instead of a rotating preview URL. Keep
# PANEL_CLOUDFLARE_PUBLIC_URL, PANEL_PAGES_PUBLIC_URL and the hostname in
# PANEL_TRUSTED_HOSTS in agreement -- a stale one here is what makes the
# panel hand out an address users can't reach.
PANEL_TUNNEL_PROVIDER=static
PANEL_CLOUDFLARE_PUBLIC_URL=https://panel.example.com
PANEL_TRUSTED_HOSTS=localhost,127.0.0.1,panel.example.com
PANEL_CLOUDFLARE_TUNNEL_TOKEN=

IMAGE_GALLERY_DB_SCHEMA=image_gallery
IMAGE_GALLERY_OWNER_USERNAMES=YOUR_USERNAME

PANEL_TELEGRAM_BOT_TOKEN=
PANEL_TELEGRAM_POLLING_ENABLED=false
# At least one of USERNAMES or CHAT_IDS is required when polling is enabled.
# USERNAMES: comma-separated Telegram @usernames (@ prefix is stripped automatically).
# CHAT_IDS:  comma-separated numeric Telegram chat IDs. Get yours by messaging the bot /id.
# After setting USERNAMES, message the bot once — it will learn and save your numeric chat ID.
PANEL_TELEGRAM_ALLOWED_USERNAMES=@YOUR_TELEGRAM_USERNAME
PANEL_TELEGRAM_ALLOWED_CHAT_IDS=

# Opt-in nightly CSV snapshots of key admin tables (accounts, gallery, lumisound,
# audit log) under PANEL_SCHEDULED_EXPORTS_DIR, pruned after 14 days. Off by default.
PANEL_SCHEDULED_EXPORTS_ENABLED=false
PANEL_SCHEDULED_EXPORTS_DIR=

GWS_DISCORD_TOKEN=
MAESTRO_DISCORD_TOKEN=
MELODIC_DISCORD_TOKEN=
NEXUS_DISCORD_TOKEN=
RHYTHM_DISCORD_TOKEN=
SYMPHONY_DISCORD_TOKEN=
TUNESTREAM_DISCORD_TOKEN=
ARIA_DISCORD_TOKEN=
